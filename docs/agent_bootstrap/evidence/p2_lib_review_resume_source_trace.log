45: def discover_profiles(world: WorldState) -> tuple[FieldProfile, ...]:
46:     profiles: list[FieldProfile] = []
47:     for entity_id, entity in sorted(world.entities.items()):
48:         component = entity.components.get(DYNAMICS_COMPONENT)
49:         if not isinstance(component, dict):
50:             continue
51:         fields = component.get("fields")
52:         if not isinstance(fields, dict):
53:             raise GameplayContractError(f"invalid dynamics fields on {entity_id!r}")
54:         for field_id, state in sorted(fields.items()):
55:             baseline = state["baseline"]
56:             definition = FieldDefinition(
57:                 field_id, float(state["domain_min"]), float(state["domain_max"]),
58:                 float(state["value"]), float(baseline["target"]),
59:                 float(baseline["rate"]), baseline["curve"],
60:                 len(state["persistent_patches"]), len(state["temporary_modifiers"]),
61:             )
62:             mirror = ("pmw_gameplay_actor", "mana") if field_id == "mana" and "pmw_gameplay_actor" in entity.components else None
63:             profiles.append(FieldProfile(entity_id, definition, mirror))
64:     return tuple(profiles)
