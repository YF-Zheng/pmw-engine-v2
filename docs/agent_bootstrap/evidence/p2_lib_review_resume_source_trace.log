438: def compile_skill_ir(ir: SkillIR) -> CompiledSkillIR:
439:     """Lower a validated IR into unchanged v0.4 SkillBlueprint values."""
440:     if not isinstance(ir, SkillIR):
441:         raise GameplayContractError("compile_skill_ir requires a trusted SkillIR")
442:     if not isinstance(ir.authority, MaterialAuthority):
443:         raise GameplayContractError(
444:             "SkillIR authority must be a trusted MaterialAuthority"
445:         )
446:     if not isinstance(ir.condition_limits, ConditionLimits):
447:         raise GameplayContractError(
448:             "SkillIR condition_limits must be a trusted ConditionLimits"
449:         )
450:     if not isinstance(ir.statuses, Mapping):
451:         raise GameplayContractError(
452:             "SkillIR statuses must be a trusted mapping"
453:         )
454:     if not isinstance(ir.canonical_json, str):
455:         raise GameplayContractError(
456:             "SkillIR canonical_json must be canonical JSON text"
457:         )
458:     try:
459:         fresh = parse_skill_ir(
460:             json.loads(ir.canonical_json),
461:             ir.statuses,
462:             ir.authority,
463:             condition_limits=ir.condition_limits,
464:         )
465:         if fresh.canonical_hash != ir.canonical_hash:
466:             raise GameplayContractError(
467:                 "SkillIR canonical_hash does not match validated canonical_json"
468:             )
469:         blueprints = tuple(
470:             _lower_entry(fresh, entry)
471:             for entry in fresh.entries
472:         )
473:         metadata = tuple(
474:             SkillIRMetadata(item.id, item.version, item.canonical_hash)
475:             for item in blueprints
476:         )
477:         operators = _operators(blueprints)
478:         state_classes = _state_classes(fresh, blueprints)
479:         preview = _preview(
480:             fresh, blueprints, operators, state_classes
481:         )
482:     except GameplayContractError:
483:         raise
484:     except (
485:         json.JSONDecodeError, TypeError, KeyError, AttributeError, ValueError,
486:         RecursionError,
487:     ) as error:
488:         raise GameplayContractError(
489:             "delegated SkillIR lowering failed: "
