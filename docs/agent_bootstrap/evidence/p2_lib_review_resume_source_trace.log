66: 
67: def build_runtime(
68:     world: WorldState,
69:     profiles: Iterable[FieldProfile] | None = None,
70:     extra_laws: Iterable[Mapping[str, Any]] = (),
71: ) -> GameplaySession:
72:     migrate_gameplay_world(world)
73:     profiles = tuple(profiles) if profiles is not None else discover_profiles(world)
74:     laws = [*build_dynamics_laws(profiles), *[dict(item) for item in extra_laws]]
75:     parsed = [parse_law(item) for item in sorted(laws, key=lambda item: item["id"])]
76:     return GameplaySession(Engine(parsed).attach(world), profiles)
