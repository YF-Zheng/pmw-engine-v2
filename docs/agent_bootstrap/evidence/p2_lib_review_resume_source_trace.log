197: 
198: def advance_world_tick(session: GameplaySession, *, clock_id: str = "pmw:v04:clock") -> TickResult:
199:     clock = _clock(session, clock_id)
200:     step = clock["next_step"]
201:     target_time = clock["next_time"]
202:     session.runtime.advance_to(float(target_time))
203:     _validate_runtime_priorities(session)
204:     result = session.runtime.run_event(Event(
205:         id=f"pmw:v04:world-tick:{step:08d}", type=WORLD_TICK_EVENT,
206:         time=float(target_time), source=clock_id, payload={"step": step},
207:     ))
208:     completed = _clock(session, clock_id)
209:     if completed["last_completed_step"] != step or completed["next_step"] != step + 1:
210:         raise GameplayContractError("world_tick did not complete exactly once")
211:     return TickResult(step, float(target_time), result, session.snapshot())
