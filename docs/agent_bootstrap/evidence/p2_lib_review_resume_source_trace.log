131: def _validate_json_shape(raw: Any) -> None:
132:     """Reject non-JSON values and excessive input before recursive copying."""
133:     stack = [(raw, "$", 0)]
134:     value_count = 1
135:     if value_count > MAX_JSON_VALUES:
136:         raise GameplayContractError(
137:             f"$ exceeds JSON value limit {MAX_JSON_VALUES}"
138:         )
139:     while stack:
140:         value, path, depth = stack.pop()
141: 
142:         if value is None:
143:             continue
144:         if isinstance(value, dict):
145:             child_depth = depth + 1

