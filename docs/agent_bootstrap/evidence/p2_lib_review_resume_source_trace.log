78: 
79: def migrate_gameplay_world(world: WorldState) -> None:
80:     """Idempotently attach fields introduced after the original v0.4 checkpoint.
81: 
82:     Unknown historical shield provenance is deliberately represented as one
83:     unowned legacy layer.  In particular, an active historical Guard status is
84:     never allowed to claim that value and therefore cannot erase it on expiry.
85:     """
86:     for entity in world.entities.values():
87:         actor = entity.components.get("pmw_gameplay_actor")
88:         if not isinstance(actor, dict):
89:             continue
90:         if SHIELD_COMPONENT not in entity.components:
91:             component = shield_component()
92:             reconcile_shields(actor, component)
93:             entity.components[SHIELD_COMPONENT] = component
94:         statuses = entity.components.get(STATUS_COMPONENT)
95:         slots = statuses.get("slots") if isinstance(statuses, dict) else None
96:         if isinstance(slots, dict):
97:             for row in slots.values():
98:                 if isinstance(row, dict) and "shield_layer_slot" not in row:
99:                     row["shield_layer_slot"] = None
100:         ownership_statuses = statuses if isinstance(slots, dict) else {"slots": {}}
101:         migrate_status_shield_ownership(
102:             actor, ownership_statuses, entity.components[SHIELD_COMPONENT]
103:         )
