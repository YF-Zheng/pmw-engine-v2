163: 
164: def remove_source(
165:     session: GameplaySession,
166:     *,
167:     entity_id: str,
168:     field_id: str,
169:     source_id: str,
170:     owner: str,
171: ):
172:     _profile(session, entity_id, field_id)
173:     field = _field_state(session, entity_id, field_id)
174:     matches = []
175:     for layer, key in (("persistent", "persistent_patches"), ("temporary", "temporary_modifiers")):
176:         matches.extend(
177:             (layer, slot, item) for slot, item in field[key].items()
178:             if item["active"] and item["source_id"] == source_id and item["owner"] == owner
179:         )
180:     if len(matches) != 1:
181:         raise GameplayContractError("source ownership does not identify one active source")
182:     layer, slot, item = matches[0]
183:     payload = {
184:         "entity_id": entity_id, "field_id": field_id, "layer": layer,
185:         "slot": slot, "source_id": source_id, "owner": owner,
186:         "expiry_handle": item["expiry_handle"],
187:     }
188:     result = session.runtime.run_event(Event(
189:         id=f"pmw:v04:source:remove:{entity_id}:{field_id}:{source_id}",
190:         type=SOURCE_REMOVE_EVENT, time=session.state.sim_time,
191:         source=owner, target=entity_id, payload=payload,
192:     ))
193:     if not result.changed:
194:         raise GameplayContractError("source removal failed")
195:     return result
