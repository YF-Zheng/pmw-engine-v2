106: def apply_source(
107:     session: GameplaySession,
108:     *,
109:     entity_id: str,
110:     field_id: str,
111:     layer: str,
112:     source: DynamicsSource,
113: ):
114:     if layer not in {"persistent", "temporary"}:
115:         raise GameplayContractError("layer must be persistent or temporary")
116:     profile = _profile(session, entity_id, field_id)
117:     validate_source(source, profile.field, temporary=layer == "temporary")
118:     field = _field_state(session, entity_id, field_id)
119:     all_slots = [
120:         *field["persistent_patches"].values(),
121:         *field["temporary_modifiers"].values(),
122:     ]
123:     if any(item["active"] and item["source_id"] == source.source_id for item in all_slots):
124:         raise GameplayContractError("source_id is already active on this Field")
125:     if source.curve_priority is not None and any(
126:         item["active"] and item["curve_priority"] == source.curve_priority
127:         for item in all_slots
128:     ):
129:         raise GameplayContractError("curve override priority conflict")
130:     key = "persistent_patches" if layer == "persistent" else "temporary_modifiers"
131:     slot = next((name for name, item in sorted(field[key].items()) if not item["active"]), None)
132:     if slot is None:
133:         raise GameplayContractError(f"{layer} source capacity exhausted")
134:     handle = None
135:     expiry_event = None
136:     if layer == "temporary":
137:         handle = f"pmw:v04:expiry:{entity_id}:{field_id}:{source.source_id}:{source.owner}"
138:         expiry_time = session.state.sim_time + source.duration_ticks
139:         expiry_payload = {
140:             "entity_id": entity_id, "field_id": field_id, "layer": layer,
141:             "slot": slot, "source_id": source.source_id, "owner": source.owner,
142:             "expiry_handle": handle,
143:         }
144:         expiry_event = {
145:             "id": handle, "type": SOURCE_EXPIRE_EVENT, "time": expiry_time,
146:             "source": source.owner, "target": entity_id, "payload": expiry_payload,
147:         }
148:     payload = {
149:         "entity_id": entity_id, "field_id": field_id, "layer": layer,
150:         "slot": slot, "source_id": source.source_id, "owner": source.owner,
151:         "source": source_state(source, handle), "expiry_event": expiry_event,
152:     }
153:     event = Event(
154:         id=f"pmw:v04:source:apply:{entity_id}:{field_id}:{source.source_id}",
155:         type=SOURCE_APPLY_EVENT, time=session.state.sim_time,
156:         source=source.owner, target=entity_id, payload=payload,
157:     )
158:     result = session.runtime.run_event(event)
159:     if not result.changed:
160:         raise GameplayContractError("source apply did not match its reserved slot")
161:     return result
